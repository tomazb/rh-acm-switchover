{
  "_comment": "R4-06 PR 2 shared single-file kubeconfig vectors (amendment 2026-10-15 \u00a73-\u00a75). Hand-authored; Python (lib/kubeconfig_merge.py, one-file KUBECONFIG) and the collection (plugins/module_utils/kubeconfig_file.py) must reach the same result. result is 'ok' or the stable reason; ok rows list the resolved entry names per section.",
  "single_file": [
    {
      "case": "minimal valid",
      "yaml": "apiVersion: v1\nclusters:\n- name: k\n  cluster: {server: 'https://h:6443'}\ncontexts:\n- name: c\n  context: {cluster: k, user: u}\nusers:\n- name: u\n  user: {token: t}\n",
      "result": "ok",
      "names": {
        "clusters": [
          "k"
        ],
        "contexts": [
          "c"
        ],
        "users": [
          "u"
        ]
      }
    },
    {
      "case": "null sections are empty",
      "yaml": "clusters: null\ncontexts: null\nusers: null\n",
      "result": "ok",
      "names": {
        "clusters": [],
        "contexts": [],
        "users": []
      }
    },
    {
      "case": "duplicate mapping key",
      "yaml": "clusters: []\nclusters: []\n",
      "result": "kubeconfig_load_failed (duplicate_yaml_key)"
    },
    {
      "case": "nested duplicate mapping key",
      "yaml": "clusters:\n- name: k\n  cluster: {server: 'https://a', server: 'https://b'}\n",
      "result": "kubeconfig_load_failed (duplicate_yaml_key)"
    },
    {
      "case": "merge key",
      "yaml": "base: &b {server: 'https://h'}\nclusters:\n- name: k\n  cluster:\n    <<: *b\n",
      "result": "kubeconfig_load_failed (yaml_invalid)"
    },
    {
      "case": "invalid yaml",
      "yaml": "clusters: [\n",
      "result": "kubeconfig_load_failed (yaml_invalid)"
    },
    {
      "case": "constructor error",
      "yaml": "clusters: !!int notanumber\n",
      "result": "kubeconfig_load_failed (yaml_invalid)"
    },
    {
      "case": "yaml set",
      "yaml": "clusters: !!set {a, b}\n",
      "result": "kubeconfig_load_failed (structure_invalid)"
    },
    {
      "case": "recursive list alias",
      "yaml": "clusters: &a [*a]\n",
      "result": "kubeconfig_load_failed (structure_invalid)"
    },
    {
      "case": "recursive mapping alias",
      "yaml": "clusters:\n- &c {name: k, cluster: {server: 'https://h', self: *c}}\n",
      "result": "kubeconfig_load_failed (structure_invalid)"
    },
    {
      "case": "omap value",
      "yaml": "x: !!omap [a: 1]\n",
      "result": "kubeconfig_load_failed (structure_invalid)"
    },
    {
      "case": "shared non-recursive alias",
      "yaml": "clusters:\n- {name: a, cluster: &s {server: 'https://h'}}\n- {name: b, cluster: *s}\n",
      "result": "ok",
      "names": {
        "clusters": [
          "a",
          "b"
        ],
        "contexts": [],
        "users": []
      }
    },
    {
      "case": "root not a mapping",
      "yaml": "- a\n",
      "result": "kubeconfig_load_failed (structure_invalid)"
    },
    {
      "case": "section not a list",
      "yaml": "clusters: {}\n",
      "result": "kubeconfig_load_failed (structure_invalid)"
    },
    {
      "case": "entry without name",
      "yaml": "clusters:\n- cluster: {server: 'https://h'}\n",
      "result": "kubeconfig_load_failed (structure_invalid)"
    },
    {
      "case": "present null member",
      "yaml": "clusters:\n- name: k\n  cluster: null\n",
      "result": "kubeconfig_load_failed (structure_invalid)"
    },
    {
      "case": "context cluster not a string",
      "yaml": "contexts:\n- name: c\n  context: {cluster: 1}\n",
      "result": "kubeconfig_load_failed (structure_invalid)"
    },
    {
      "case": "identical duplicates resolve first-wins",
      "yaml": "clusters:\n- {name: k, cluster: {server: 'https://h'}}\n- name: k\n  cluster:\n    server: https://h\n",
      "result": "ok",
      "names": {
        "clusters": [
          "k"
        ],
        "contexts": [],
        "users": []
      }
    },
    {
      "case": "identical duplicates with reordered keys",
      "yaml": "users:\n- {name: u, user: {token: t, username: x}}\n- {user: {username: x, token: t}, name: u}\n",
      "result": "ok",
      "names": {
        "clusters": [],
        "contexts": [],
        "users": [
          "u"
        ]
      }
    },
    {
      "case": "conflicting duplicate cluster",
      "yaml": "clusters:\n- {name: k, cluster: {server: 'https://one'}}\n- {name: k, cluster: {server: 'https://two'}}\n",
      "result": "kubeconfig_duplicate_conflict"
    },
    {
      "case": "conflicting duplicate int vs bool",
      "yaml": "clusters:\n- {name: k, cluster: {server: 'https://h', x: 1}}\n- {name: k, cluster: {server: 'https://h', x: true}}\n",
      "result": "kubeconfig_duplicate_conflict"
    },
    {
      "case": "conflicting duplicate int vs string",
      "yaml": "users:\n- {name: u, user: {x: 1}}\n- {name: u, user: {x: '1'}}\n",
      "result": "kubeconfig_duplicate_conflict"
    },
    {
      "case": "conflicting duplicate context",
      "yaml": "contexts:\n- {name: c, context: {cluster: a}}\n- {name: c, context: {cluster: b}}\n",
      "result": "kubeconfig_duplicate_conflict"
    },
    {
      "case": "same name in different kinds is not a duplicate",
      "yaml": "clusters:\n- {name: x, cluster: {server: 'https://h'}}\ncontexts:\n- {name: x, context: {cluster: x}}\nusers:\n- {name: x, user: {}}\n",
      "result": "ok",
      "names": {
        "clusters": [
          "x"
        ],
        "contexts": [
          "x"
        ],
        "users": [
          "x"
        ]
      }
    },
    {
      "case": "signed zero duplicates are identical",
      "yaml": "users:\n- {name: u, user: {x: 0.0}}\n- {name: u, user: {x: -0.0}}\n",
      "result": "ok",
      "names": {
        "clusters": [],
        "contexts": [],
        "users": [
          "u"
        ]
      }
    },
    {
      "case": "the same instant with different offsets is identical",
      "yaml": "users:\n- {name: u, user: {at: 2026-10-15T10:00:00+02:00}}\n- {name: u, user: {at: 2026-10-15T08:00:00Z}}\n",
      "result": "ok",
      "names": {
        "clusters": [],
        "contexts": [],
        "users": [
          "u"
        ]
      }
    },
    {
      "case": "different instants conflict",
      "yaml": "users:\n- {name: u, user: {at: 2026-10-15T10:00:00+02:00}}\n- {name: u, user: {at: 2026-10-15T10:00:00Z}}\n",
      "result": "kubeconfig_duplicate_conflict"
    },
    {
      "case": "float and int conflict",
      "yaml": "users:\n- {name: u, user: {x: 1.0}}\n- {name: u, user: {x: 1}}\n",
      "result": "kubeconfig_duplicate_conflict"
    },
    {
      "case": "nan duplicates are identical",
      "yaml": "users:\n- {name: u, user: {x: .nan}}\n- {name: u, user: {x: .NaN}}\n",
      "result": "ok",
      "names": {
        "clusters": [],
        "contexts": [],
        "users": [
          "u"
        ]
      }
    }
  ]
}

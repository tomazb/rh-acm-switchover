# Multi-stage build for ACM Switchover Automation
# Based on Red Hat Universal Base Image 9

# Stage 1: Build stage with full tooling
FROM registry.access.redhat.com/ubi9/python-312@sha256:52d1ffcda3b9552934f947b7d41fb0cb66973bdc0d7e91814facadc126f68663 AS builder

USER root

# Install build dependencies
RUN dnf install -y \
    gcc \
    python3.12-devel \
    && dnf clean all

# Copy requirements and install Python dependencies
COPY requirements.txt /tmp/
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /tmp/requirements.txt

# Stage 2: Runtime stage with minimal footprint
FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:ae09ecc3d754bc1726cbda3e2599cc7839e09fe1cc547ce173cf669b645be3cc

LABEL name="acm-switchover" \
    vendor="Red Hat" \
    version="1.7.10" \
      release="1" \
      summary="ACM Hub Switchover Automation Tool" \
      description="Automated, idempotent tool for switching over Red Hat Advanced Cluster Management (ACM) from a primary hub to a secondary hub cluster." \
      maintainer="Platform Engineering" \
      io.k8s.description="ACM Hub Switchover Automation with comprehensive validation and rollback capabilities" \
      io.k8s.display-name="ACM Switchover" \
      io.openshift.tags="acm,openshift,kubernetes,backup,disaster-recovery"

# Define versions and verified artifact checksums
ARG OC_VERSION=4.21
ARG JQ_VERSION=1.7.1
ARG PYTHON_VERSION=3.12
ARG JQ_LINUX_AMD64_SHA256=5942c9b0934e510ee61eb3e30273f1b3fe2590df93933a93d7c58b81d19c8ff5
ARG JQ_LINUX_ARM64_SHA256=4dd2d8a0661df0b22f1bb9a1f9830f06b6f3b8f7d91211a1ef5d7c4f06a8b4a5
ARG OPENSHIFT_CLIENT_LINUX_AMD64_SHA256=9440dc8ce8c1305b450c2aa8188a6a5fda69f4dd52d69c761715cd12e1aefdf8
ARG OPENSHIFT_CLIENT_LINUX_ARM64_SHA256=dd09d32e1b6a53466934c58360c8044212706aeaa04b1f827f284bac0ceb8a64

USER root

# Install required packages
RUN microdnf install -y \
    python3.12 \
    python3.12-pip \
    python3.12-setuptools \
    tar \
    gzip \
    curl-minimal \
    ca-certificates \
    && microdnf clean all

# Install jq for JSON processing
RUN set -eu; \
    ARCH=$(uname -m); \
    if [ "$ARCH" = "x86_64" ]; then \
        JQ_ARCH="amd64"; \
        JQ_SHA256="${JQ_LINUX_AMD64_SHA256}"; \
    elif [ "$ARCH" = "aarch64" ]; then \
        JQ_ARCH="arm64"; \
        JQ_SHA256="${JQ_LINUX_ARM64_SHA256}"; \
    else \
        echo "Unsupported architecture: ${ARCH}" >&2; \
        exit 1; \
    fi; \
    curl -fsSL "https://github.com/jqlang/jq/releases/download/jq-${JQ_VERSION}/jq-linux-${JQ_ARCH}" \
        -o "/tmp/jq-linux-${JQ_ARCH}"; \
    printf '%s  %s\n' "${JQ_SHA256}" "/tmp/jq-linux-${JQ_ARCH}" > "/tmp/jq-linux-${JQ_ARCH}.sha256"; \
    sha256sum -c "/tmp/jq-linux-${JQ_ARCH}.sha256"; \
    cp "/tmp/jq-linux-${JQ_ARCH}" /usr/local/bin/jq; \
    chmod 0755 /usr/local/bin/jq; \
    rm -f "/tmp/jq-linux-${JQ_ARCH}" "/tmp/jq-linux-${JQ_ARCH}.sha256"

# Install OpenShift CLI (oc)
RUN set -eu; \
    ARCH=$(uname -m); \
    if [ "$ARCH" = "x86_64" ]; then \
        OC_ARCH="amd64"; \
        OC_SHA256="${OPENSHIFT_CLIENT_LINUX_AMD64_SHA256}"; \
    elif [ "$ARCH" = "aarch64" ]; then \
        OC_ARCH="arm64"; \
        OC_SHA256="${OPENSHIFT_CLIENT_LINUX_ARM64_SHA256}"; \
    else \
        echo "Unsupported architecture: ${ARCH}" >&2; \
        exit 1; \
    fi; \
    curl -fsSL "https://mirror.openshift.com/pub/openshift-v4/${OC_ARCH}/clients/ocp/stable-${OC_VERSION}/openshift-client-linux.tar.gz" \
        -o /tmp/openshift-client-linux.tar.gz; \
    printf '%s  %s\n' "${OC_SHA256}" "/tmp/openshift-client-linux.tar.gz" \
        > /tmp/openshift-client-linux.tar.gz.sha256; \
    sha256sum -c /tmp/openshift-client-linux.tar.gz.sha256; \
    tar -xzf /tmp/openshift-client-linux.tar.gz -C /usr/local/bin oc kubectl; \
    chmod 0755 /usr/local/bin/oc /usr/local/bin/kubectl; \
    rm -f /tmp/openshift-client-linux.tar.gz /tmp/openshift-client-linux.tar.gz.sha256

# Copy Python packages from builder
COPY --from=builder /opt/app-root/lib/python3.12/site-packages /usr/lib/python3.12/site-packages

# Create application user and directories
RUN useradd -r -u 1001 -g 0 -d /app -s /sbin/nologin \
    -c "ACM Switchover User" acm-switchover && \
    mkdir -p /app /var/lib/acm-switchover /etc/acm-switchover && \
    chown -R 1001:0 /app /var/lib/acm-switchover /etc/acm-switchover && \
    chmod -R g=u /app /var/lib/acm-switchover /etc/acm-switchover

# Set working directory
WORKDIR /app

# Copy application code
COPY --chown=1001:0 acm_switchover.py /app/
COPY --chown=1001:0 lib/ /app/lib/
COPY --chown=1001:0 modules/ /app/modules/
COPY --chown=1001:0 scripts/ /app/scripts/
COPY --chown=1001:0 requirements.txt /app/
COPY --chown=1001:0 LICENSE /app/
COPY --chown=1001:0 README.md /app/

# Make scripts executable
RUN chmod +x /app/acm_switchover.py \
    /app/scripts/*.sh

# Switch to non-root user
USER 1001

# Set environment variables
ENV PATH="/app:/app/scripts:${PATH}" \
    PYTHONPATH="/usr/lib/python3.12/site-packages" \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=UTF-8 \
    STATE_DIR=/var/lib/acm-switchover \
    HOME=/app

# Create state directory structure
RUN mkdir -p ${STATE_DIR}/.state

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python3.12 -c "import sys; sys.exit(0)" || exit 1

# Default entrypoint
ENTRYPOINT ["python3.12", "/app/acm_switchover.py"]

# Default command (show help)
CMD ["--help"]

# Volume mounts for kubeconfig and state
VOLUME ["/var/lib/acm-switchover", "/app/.kube"]

# Expose metadata
#EXPOSE 8080/tcp
